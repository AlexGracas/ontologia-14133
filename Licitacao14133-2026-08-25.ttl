[ rdf:type owl:AllDisjointClasses ] owl:members (:GovernoFederal :GovernoEstadual :GovernoMunicipal).
:Governo owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:GovernoFederal :GovernoEstadual :GovernoMunicipal)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Pregao :Concorrencia :Concurso :Leilao :DialogoCompetitivo).
:Disputa owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Pregao :Concorrencia :Concurso :Leilao :DialogoCompetitivo)
].
:Autor owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:AutorCorporativo :AutorPessoaFisica)
].
