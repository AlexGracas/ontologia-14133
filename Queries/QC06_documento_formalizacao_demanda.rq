# QC6 — Qual é a utilidade do Documento de Formalização de Demanda para a área requisitante?
#
# Ontologia: Licitacao14133.ttl (exportada em 2026-08-25)
#

# ======================================================================
# Definição do Documento de Formalização de Demanda (DFD)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Definição (rótulo e descrição) da(s) classe(s) central(is) para esta pergunta.
SELECT ?classe ?rotulo ?descricao
WHERE {
  VALUES ?classe { :DocumentoDeFormalizacaoDeDemamanda }
  ?classe rdfs:label ?rotulo .
  OPTIONAL { ?classe rdfs:comment ?descricao }
}

# ======================================================================
# Propriedades relacionadas ao DFD (unidade e pessoa responsável, dependências, atributos)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Propriedades (de objeto e de dados) cujo domínio ou range é esta classe.
SELECT ?propriedade ?tipoPropriedade ?dominio ?range
WHERE {
  ?propriedade rdf:type ?tipoPropriedade .
  FILTER(?tipoPropriedade IN (owl:ObjectProperty, owl:DatatypeProperty))
  {
    ?propriedade rdfs:domain :DocumentoDeFormalizacaoDeDemamanda .
    BIND(:DocumentoDeFormalizacaoDeDemamanda AS ?dominio)
    OPTIONAL { ?propriedade rdfs:range ?range }
  }
  UNION
  {
    ?propriedade rdfs:range :DocumentoDeFormalizacaoDeDemamanda .
    BIND(:DocumentoDeFormalizacaoDeDemamanda AS ?range)
    OPTIONAL { ?propriedade rdfs:domain ?dominio }
  }
}
ORDER BY ?propriedade

# ======================================================================
# Instâncias: unidade requisitante, pessoa responsável e atributos do DFD (requer dados ABox)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?dfd ?unidade ?pessoaResponsavel ?descricaoSucinta ?estimativaDeValor ?grauPrioridade ?quantidade ?dataPretendida ?justificativa
WHERE {
  ?unidade :unidadeResponsavelDemanda ?dfd .
  OPTIONAL { ?pessoaResponsavel :pessoaResponsavelDemanda ?dfd }
  OPTIONAL { ?dfd :DescricaoSucinta ?descricaoSucinta }
  OPTIONAL { ?dfd :EstimativaDeValor ?estimativaDeValor }
  OPTIONAL { ?dfd :GrauPrioridade ?grauPrioridade }
  OPTIONAL { ?dfd :Quantidade ?quantidade }
  OPTIONAL { ?dfd :DataPretendida ?dataPretendida }
  OPTIONAL { ?dfd :justificativaDaNecessidade ?justificativa }
}
