# QC7 — Quais elementos mínimos devem constar em um Estudo Técnico Preliminar (ETP)?
#
# Ontologia: Licitacao14133.ttl (exportada em 2026-08-25)
#

# ======================================================================
# Definição do Estudo Técnico Preliminar
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Definição (rótulo e descrição) da(s) classe(s) central(is) para esta pergunta.
SELECT ?classe ?rotulo ?descricao
WHERE {
  VALUES ?classe { :EstudoTecnicoPreliminar }
  ?classe rdfs:label ?rotulo .
  OPTIONAL { ?classe rdfs:comment ?descricao }
}

# ======================================================================
# Todos os elementos (propriedades) que compõem o ETP segundo a ontologia
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Propriedades (de objeto e de dados) cujo domínio ou range é esta classe.
SELECT ?propriedade ?tipoPropriedade ?dominio ?range
WHERE {
  ?propriedade rdf:type ?tipoPropriedade .
  FILTER(?tipoPropriedade IN (owl:ObjectProperty, owl:DatatypeProperty))
  {
    ?propriedade rdfs:domain :EstudoTecnicoPreliminar .
    BIND(:EstudoTecnicoPreliminar AS ?dominio)
    OPTIONAL { ?propriedade rdfs:range ?range }
  }
  UNION
  {
    ?propriedade rdfs:range :EstudoTecnicoPreliminar .
    BIND(:EstudoTecnicoPreliminar AS ?range)
    OPTIONAL { ?propriedade rdfs:domain ?dominio }
  }
}
ORDER BY ?propriedade

# ======================================================================
# Instâncias: elementos preenchidos de um ETP específico (requer dados ABox)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?etp ?necessidade ?solucao ?quantidadeContratacao ?assistenciaTecnica ?manutencao
       ?requisitosDaContratacao ?fundamentacao ?processoCorrelato ?processoDependente ?processoSimilar
WHERE {
  ?etp a :EstudoTecnicoPreliminar .
  OPTIONAL { ?etp :necessidadeDaContratacao ?necessidade }
  OPTIONAL { ?etp :solucao ?solucao }
  OPTIONAL { ?etp :quantidadeContratacao ?quantidadeContratacao }
  OPTIONAL { ?etp :necessidadeContratacaoAssistenciaTecnica ?assistenciaTecnica }
  OPTIONAL { ?etp :necessidadeContratacaoManutencao ?manutencao }
  OPTIONAL { ?etp :estudoTecnicoPreliminarHasRequisitosDaContratacao ?requisitosDaContratacao }
  OPTIONAL { ?etp :estudoTecnicoPreliminarHasFundamentacaoDaContratacao ?fundamentacao }
  OPTIONAL { ?etp :correlatos ?processoCorrelato }
  OPTIONAL { ?etp :dependentes ?processoDependente }
  OPTIONAL { ?etp :similares ?processoSimilar }
}
