# QC3 — Em quais situações o agente de contratação deve ser substituído por uma comissão de contratação?
#
# Ontologia: Licitacao14133-2026-08-25.ttl (exportada em 2026-08-25)
#

# ======================================================================
# Definições de AgenteDeContratacao e ComissaoDeContratacao (a resposta está descrita em rdfs:comment)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Definição (rótulo e descrição) da(s) classe(s) central(is) para esta pergunta.
SELECT ?classe ?rotulo ?descricao
WHERE {
  VALUES ?classe { :AgenteDeContratacao :ComissaoDeContratacao }
  ?classe rdfs:label ?rotulo .
  OPTIONAL { ?classe rdfs:comment ?descricao }
}

# ======================================================================
# Busca textual nas descrições por menção a 'substitu' (bens/serviços especiais)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?classe ?descricao
WHERE {
  ?classe rdfs:comment ?descricao .
  FILTER(CONTAINS(LCASE(STR(?descricao)), "substitu"))
}
