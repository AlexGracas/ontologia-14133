# QC15 — Quais são os motivos que justificam a inexigibilidade de licitação, como inviabilidade de competição ou fornecedor exclusivo?
#
# Ontologia: Licitacao14133.ttl (exportada em 2026-08-25)
#

# ======================================================================
# Definição de Inexigibilidade e de InviabilidadeDeCompeticao
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Definição (rótulo e descrição) da(s) classe(s) central(is) para esta pergunta.
SELECT ?classe ?rotulo ?descricao
WHERE {
  VALUES ?classe { :Inexigibilidade :InviabilidadeDeCompeticao }
  ?classe rdfs:label ?rotulo .
  OPTIONAL { ?classe rdfs:comment ?descricao }
}

# ======================================================================
# Hipóteses de inviabilidade de competição mapeadas (subclasses)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Hipóteses de inviabilidade de competição (subclasses) de :InviabilidadeDeCompeticao (fecho transitivo via rdfs:subClassOf).
SELECT ?classe ?rotulo
WHERE {
  ?classe rdfs:subClassOf+ :InviabilidadeDeCompeticao .
  OPTIONAL { ?classe rdfs:label ?rotulo }
}
ORDER BY ?classe

# ======================================================================
# Propriedade que liga a inviabilidade de competição à inexigibilidade
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Propriedades (de objeto e de dados) cujo domínio ou range é esta classe.
SELECT ?propriedade ?tipoPropriedade ?dominio ?range
WHERE {
  ?propriedade rdf:type ?tipoPropriedade .
  FILTER(?tipoPropriedade IN (owl:ObjectProperty, owl:DatatypeProperty))
  {
    ?propriedade rdfs:domain :Inexigibilidade .
    BIND(:Inexigibilidade AS ?dominio)
    OPTIONAL { ?propriedade rdfs:range ?range }
  }
  UNION
  {
    ?propriedade rdfs:range :Inexigibilidade .
    BIND(:Inexigibilidade AS ?range)
    OPTIONAL { ?propriedade rdfs:domain ?dominio }
  }
}
ORDER BY ?propriedade

# ======================================================================
# Instâncias: motivo de inexigibilidade de um processo específico (requer dados ABox)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?inviabilidade ?tipoInviabilidade ?inexigibilidade
WHERE {
  ?inviabilidade :inviabilidadeDeCompeticaoHasInexigibilidade ?inexigibilidade ;
                 a ?tipoInviabilidade .
  FILTER(?tipoInviabilidade != owl:NamedIndividual)
}
