# QC18 — Como um evento de risco é classificado em termos de probabilidade e gravidade de impacto?
#
# Ontologia: Licitacao14133-2026-08-25.ttl (exportada em 2026-08-25)
#

# ======================================================================
# Definição de Probabilidade e de GravidadeImpacto
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Definição (rótulo e descrição) da(s) classe(s) central(is) para esta pergunta.
SELECT ?classe ?rotulo ?descricao
WHERE {
  VALUES ?classe { :Probabilidade :GravidadeImpacto }
  ?classe rdfs:label ?rotulo .
  OPTIONAL { ?classe rdfs:comment ?descricao }
}

# ======================================================================
# Propriedades que ligam Probabilidade e GravidadeImpacto ao Tipo de Evento de Risco
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?propriedade ?dominio ?range
WHERE {
  VALUES ?propriedade { :probabilidadeHasTipoDeEventoDeRisco :gravidadeImpactoHasTipoDeEventoDeRisco }
  ?propriedade rdfs:domain ?dominio ;
               rdfs:range ?range .
}

# ======================================================================
# Instâncias: probabilidade e gravidade de impacto associadas a cada tipo de evento de risco (requer dados ABox)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?risco ?probabilidade ?gravidade
WHERE {
  ?probabilidade :probabilidadeHasTipoDeEventoDeRisco ?risco .
  ?gravidade :gravidadeImpactoHasTipoDeEventoDeRisco ?risco .
}
