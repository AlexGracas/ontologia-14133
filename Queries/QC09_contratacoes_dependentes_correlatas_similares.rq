# QC9 — Como a ontologia relaciona contratações dependentes, correlatas ou similares no planejamento?
#
# Ontologia: Licitacao14133.ttl (exportada em 2026-08-25)
#

# ======================================================================
# Definição das relações correlatos / dependentes / similares e da relação dependente entre DFDs
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

# Definição (rótulo e descrição) da(s) classe(s) central(is) para esta pergunta.
SELECT ?classe ?rotulo ?descricao
WHERE {
  VALUES ?classe { :EstudoTecnicoPreliminar :ProcessoLicitatrio :DocumentoDeFormalizacaoDeDemamanda }
  ?classe rdfs:label ?rotulo .
  OPTIONAL { ?classe rdfs:comment ?descricao }
}

# ======================================================================
# Domínio e range das propriedades correlatos, dependentes e similares
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?propriedade ?dominio ?range
WHERE {
  VALUES ?propriedade { :correlatos :dependentes :similares :dependente }
  OPTIONAL { ?propriedade rdfs:domain ?dominio }
  OPTIONAL { ?propriedade rdfs:range ?range }
}

# ======================================================================
# Instâncias: processos licitatórios relacionados a um Estudo Técnico Preliminar (requer dados ABox)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?etp ?processoCorrelato ?processoDependente ?processoSimilar
WHERE {
  ?etp a :EstudoTecnicoPreliminar .
  OPTIONAL { ?etp :correlatos ?processoCorrelato }
  OPTIONAL { ?etp :dependentes ?processoDependente }
  OPTIONAL { ?etp :similares ?processoSimilar }
}

# ======================================================================
# Instâncias: DFDs dependentes de outro DFD (requer dados ABox)
# ======================================================================
PREFIX : <http://university.edu/licitacao14133#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX gufo: <http://purl.org/nemo/gufo#>

SELECT ?dfd ?dfdDependente
WHERE {
  ?dfd :dependente ?dfdDependente .
}
